# Google Sheet ที่เก็บข้อมูล PM2.5 (ใช้ใน frontend)
VITE_GOOGLE_SHEET_ID=your_sheet_id_here

# Gemini API key (ใช้ใน server-side เท่านั้น — ห้ามใส่ prefix VITE_)
# ขอได้ฟรีที่ https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# (ตัวเลือก) override endpoint ของ chat API
# - ถ้า deploy frontend + serverless ใน Vercel เดียวกัน ปล่อยว่างได้ ใช้ /api/chat อัตโนมัติ
# - ถ้าแยก host เช่น frontend อยู่ GitHub Pages, backend อยู่ Cloudflare Worker ให้ใส่ URL เต็ม
# VITE_CHAT_API_URL=https://your-worker.workers.dev/api/chat
